# Copy to .env (git-ignored) and run: chmod 600 .env
# All settings and defaults are listed in DESIGN.md Section 9 and README.md.

# Slack (required for pypeit_chat_slack)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
HOME_TEAM_ID=T...
ADMIN_CHANNEL_ID=C...
ADMIN_USER_IDS=U...,U...

# Beta restrictions (empty = no restriction)
ALLOWED_CHANNEL_IDS=
ALLOWED_USER_IDS=
BLOCKED_USER_IDS=

# Model server (OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:11434/v1
CHAT_MODEL=qwen3.8:27b-mlx
EMBED_MODEL=nomic-embed-text
# How the runtime switches reasoning off: reasoning_effort (Ollama),
# chat_template_kwargs (vLLM, llama.cpp) or none.
THINK_SWITCH=reasoning_effort

# Logging: store question/answer text (on for the private and beta stages)
LOG_TEXT=0
LOG_RETENTION_DAYS=180
